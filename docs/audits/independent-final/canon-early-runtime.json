    {
      "slug": "seven-questions",
      "label": "valley-default",
      "choices": [
        {
          "text": "先同禾生核金陵副报，再请他带原件一起去问另一家。",
          "tags": [
            "cid:sq_joint_jinling"
          ]
        },
        {
          "text": "在待核项写明所见来源，让传言与死伤名单分开。",
          "tags": [
            "cid:sq_keep_unknown"
          ]
        },
        {
          "text": "把旧痕与新试分放两侧，按陆所指处记，不自行下归属。",
          "tags": [
            "cid:sq_hold_both"
          ]
        },
        {
          "text": "带共同核问的人去送试痕副报，愿多走一趟。",
          "tags": [
            "cid:sq_send_with_witness"
          ]
        },
        {
          "text": "先把真内容与后加扉页并排给门外人看，再请他们让路。",
          "tags": [
            "cid:sq_compare_front"
          ]
        },
        {
          "text": "从侧门接出抄手，不往两剑中间插，自己让掉近处观剑位置。",
          "tags": [
            "cid:sq_take_side"
          ]
        },
        {
          "text": "将两次验痕一起送出，金陵和南岳各留一份过程。",
          "tags": [
            "cid:sq_add_second_test"
          ]
        },
        {
          "text": "先把周最后所见按原话抄给共同收件人，不添自己猜的姓名。",
          "tags": [
            "cid:sq_keep_last_words"
          ]
        },
        {
          "text": "按共同收件的约定，去金陵一侧接问件，不擅坐空椅。",
          "tags": [
            "cid:sq_sit_by_jinling"
          ]
        },
        {
          "text": "把入化前门人的问题递入问件：不能照练，那能先知道哪些风险？",
          "tags": [
            "cid:sq_ask_access"
          ]
        },
        {
          "text": "把散开的问件收齐，仍按原题交回，不用止斗一剑替代答复。",
          "tags": [
            "cid:sq_return_questions"
          ]
        },
        {
          "text": "先把年轻门人所问的风险说明递给主张附注的人，自己候一个可带走的答复。",
          "tags": [
            "cid:sq_deliver_risk"
          ]
        },
        {
          "text": "分别抄明萧与闻人的线索，不把两人履历并成一个无所不能的凶手。",
          "tags": [
            "cid:sq_link_without_merge"
          ]
        },
        {
          "text": "去问真走过旧河的人，标能撤过的溪沟，院中转报请同门接。",
          "tags": [
            "cid:sq_walk_water"
          ]
        },
        {
          "text": "随混编队赴伏牛，担撤路和返程传讯，嵩阳由留守者接。",
          "tags": [
            "cid:sq_follow_valley"
          ]
        },
        {
          "text": "先把离树最近的伤者交过去，自己留低处接下一人。",
          "tags": [
            "cid:sq_pass_first"
          ]
        },
        {
          "text": "守住已认的接应点，放过近处观高手的机会。",
          "tags": [
            "cid:sq_stay_receiving"
          ]
        },
        {
          "text": "先确认最后一班已过沟，再向后方报空，不催慧寂为抢胜离开弟子。",
          "tags": [
            "cid:sq_last_bank"
          ]
        },
        {
          "text": "先带伤者离开余火，假本与地图留给有余手的人收。",
          "tags": [
            "cid:sq_take_wounded"
          ]
        },
        {
          "text": "返程只报亲见的谷中撤退与地图，院中情况等留守人核，不造自己赶回时辰。",
          "tags": [
            "cid:sq_report_seen_valley"
          ]
        },
        {
          "text": "等陆回到外廊再递水，先留退处，不上前拦着问招。",
          "tags": [
            "cid:sq_receive_later"
          ]
        },
        {
          "text": "把两路亲见和后闻分栏，再让同伴核自己的姓名，不抢一份全知通报。",
          "tags": [
            "cid:sq_separate_witness"
          ]
        },
        {
          "text": "经录事转问还未归的人与物在哪里，不把听见一段怨恨当成已问全案。",
          "tags": [
            "cid:sq_ask_missing_people"
          ]
        },
        {
          "text": "逐卷核回来源、封存与接手，不拿看见三卷便替另四签全。",
          "tags": [
            "cid:sq_check_each_volume"
          ]
        },
        {
          "text": "接下混编传讯的常差，把前两卷与核过的风险说明送到真收件人手里。",
          "tags": [
            "cid:sq_choose_carriers"
          ]
        },
        {
          "text": "按同伴答应的两趟或八月交班，自己补余下的行程与课，不用旧恩情压人。",
          "tags": [
            "cid:sq_keep_companion_time"
          ]
        },
        {
          "text": "交清最后一份，回自己的常差，不拿这次听见的话替别人许成就。",
          "tags": [
            "cid:sq_return_receipt"
          ]
        }
      ],
      "beats": [
        {
          "text": "接了你交接的那一班已歇下。合报时，别再叫淋过水的人重跑一遍。",
          "tags": [
            "beat:sq_converge_9",
            "scene:sq_return",
            "cast:sq_hesheng,sq_asheng",
            "speaker:sq_asheng",
            "mood:sq_asheng=neutral"
          ]
        }
      ],
      "ending": {
        "text": "你把前两卷送出鹿门，同行的人会换，收件处也会换。有人只想抢先抄一句，你便等他把附注翻开，再说哪处还须问老师。到八月，接班者真站在路口，你没有让所有人永远等着同一个人回来。",
        "tags": [
          "beat:sq_afterwards_9",
          "scene:sq_after",
          "cast:none",
          "speaker:narrator",
          "ending:sq_shared_road"
        ]
      },
      "totalBeats": 254
    },
    {
      "slug": "taihua",
      "label": "first",
      "choices": [
        {
          "text": "先把水盆移到师兄够得着的地方。",
          "tags": [
            "cid:th_care"
          ]
        },
        {
