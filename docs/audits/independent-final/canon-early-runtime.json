            "cid:th_rush"
          ]
        },
        {
          "text": "承认自己仍在抖，不把胜场说得轻松。",
          "tags": [
            "cid:th_admit"
          ]
        },
        {
          "text": "拿护腕摆出双方的脚位，把失败也讲全。",
          "tags": [
            "cid:th_demonstrate"
          ]
        },
        {
          "text": "先认自己以为破袖便快分胜负，再看明澄为什么没退最后两步。",
          "tags": [
            "cid:th_watch_torn_sleeve"
          ]
        },
        {
          "text": "不拿看见他弃剑便来劝已经尽力，留他先走完，再到门口看。",
          "tags": [
            "cid:th_leave_xie_room"
          ]
        },
        {
          "text": "替明澄拿住汤碗，留门口一条退路。",
          "tags": [
            "cid:th_tray"
          ]
        },
        {
          "text": "承认自己也想看，别把停手全推给他们。",
          "tags": [
            "cid:th_no_result"
          ]
        },
        {
          "text": "约沈照微轮战后再拆那半息，不约让招。",
          "tags": [
            "cid:th_practice"
          ]
        },
        {
          "text": "并看三十七、四十一、四十八次退法，判断他是否每回都在让出同一个地方。",
          "tags": [
            "cid:th_read_retreats"
          ]
        },
        {
          "text": "看他拾剑后的落脚，不把未追写成慈悲；先问自己若在那一步会不会停。",
          "tags": [
            "cid:th_read_unstable"
          ]
        },
        {
          "text": "不催自己抢胜，守过前几十手再找机会。",
          "tags": [
            "cid:th_patience"
          ]
        },
        {
          "text": "认她这次改了路，问她从哪里看出你的习惯。",
          "tags": [
            "cid:th_credit_shen"
          ]
        },
        {
          "text": "把输了的一场也从第一步讲给他。",
          "tags": [
            "cid:th_keep_promise"
          ]
        },
        {
          "text": "问霍停云：你想赢到哪里才算够？",
          "tags": [
            "cid:th_ask_huo"
          ]
        },
        {
          "text": "将看不明的三处各记下来，不因只懂一点就把余下全写成深不可测。",
          "tags": [
            "cid:th_name_unknown"
          ]
        },
        {
          "text": "记剑真到与身体后移的先后，先不把半寸当作只需背熟的量。",
          "tags": [
            "cid:th_draw_half_distance"
          ]
        },
        {
          "text": "等行礼后请张指自己还想走的方向，承认不懂，不求把门槛一句讲完。",
          "tags": [
            "cid:th_ask_stop"
          ]
        },
        {
          "text": "只问糕还有没有，不替任何人解释旧伤。",
          "tags": [
            "cid:th_plain"
          ]
        },
        {
          "text": "将四息也记入这一场，不把没挥剑的一段当作两人都在歇。",
          "tags": [
            "cid:th_keep_four_breaths"
          ]
        },
        {
          "text": "将季亲口认先记下，别以两人俱能伤为由擅改平。",
          "tags": [
            "cid:th_keep_true_stop"
          ]
        },
        {
          "text": "承认自己更早便看不懂，请霍说第一手在找什么。",
          "tags": [
            "cid:th_public_question"
          ]
        },
        {
          "text": "将自己仍看不清的早一步摆给张问，不急求穆的那一剑，肯只从自己的回身走起。",
          "tags": [
            "cid:th_show_front_page"
          ]
        },
        {
          "text": "向谢问他哪里以为已明白，肯听霍先拆掉开头，不拿自己也旁观过便替他说懂。",
          "tags": [
            "cid:th_tell_meal_question"
          ]
        },
        {
          "text": "留下半日，与同辈复手，再陪受伤师兄下山。",
          "tags": [
            "cid:th_together"
          ]
        },
        {
          "text": "先接重箱到第一处交接，只把药包留给师兄。",
          "tags": [
            "cid:th_carry"
          ]
        }
      ],
      "beats": [
        {
          "text": "第一百零二手，她封你肩，你脚下一错，以肩抵入；她的手也停在你颈侧。",
          "tags": [
            "beat:th_centre_2",
            "scene:th_stone",
            "cast:th_shen",
            "speaker:narrator"
          ]
        },
        {
          "text": "这一回，你败。",
          "tags": [
            "beat:th_sima_result_6",
            "scene:th_round",
            "cast:th_sima,th_shen",
            "speaker:narrator"
          ]
        }
      ],
      "ending": {
        "text": "回山后，你和师兄把这半日续成两个人能做的练习。下一届的约不保证再赢，却有具体的人、有收信的地址，也有需要你真正到场的一天。",
        "tags": [
          "beat:th_ending_24",
          "scene:th_home",
          "cast:th_bro",
          "speaker:narrator",
          "ending:th_company"
        ]
      },
      "totalBeats": 308
    },
    {
      "slug": "longmen",
      "label": "first",
      "choices": [
        {
          "text": "承认只记了次序，请他先让我摆出这一刀。",
          "tags": [
            "cid:lm_ask_use"
          ]
        },
        {
          "text": "问旧伤现在怎样影响他，不把战绩当没受过伤。",
          "tags": [
            "cid:lm_ask_wound"
          ]
        },
        {
          "text": "先问一个武当道人为何还认得宋老的旧刀。",
          "tags": [
            "cid:lm_ask_qinghe_friend"
          ]
        },
        {
          "text": "先看左脚，试着把落点压回旧谱的位置。",
          "tags": [
            "cid:lm_old_watch_foot"
          ]
        },
        {
          "text": "先收右肘，不强追先前定好的刀头。",
          "tags": [
            "cid:lm_old_close_elbow"
          ]
        },
        {
          "text": "承认三下都没接住，再问自己还能怎么练。",
          "tags": [
            "cid:lm_old_ask_twenty"
          ]
        },
        {
          "text": "借刀以后，先练停住一步，不赶着连完十七刀。",
          "tags": [
            "cid:lm_practice_slow"
          ]
        },
        {
          "text": "留在镇河门，带初入门的人试起手，走传承一线。",
          "tags": [
            "cid:lm_route_school"
          ]
        },
        {
          "text": "把木刀放低，与他一同走退线，先让身体知道哪儿能停。",
          "tags": [
            "cid:lm_show_lane"
          ]
        },
        {
          "text": "让同门别再喊野榜，输了也照样行礼。",
          "tags": [
            "cid:lm_stop_mock"
          ]
        },
        {
          "text": "照实报一百一十九合，不拿旧伤替许解释。",
          "tags": [
            "cid:lm_name_loss"
          ]
        },
        {
          "text": "请同门分抬，自己只接绳的一头。",
          "tags": [
            "cid:lm_share_frame"
          ]
        },
        {
          "text": "守住侧门，把人退回去，错过中间几招也认。",
          "tags": [
            "cid:lm_guard_line"
          ]
        },
        {
          "text": "把剑原样递还，不先说败得光荣之类宽慰。",
          "tags": [
            "cid:lm_return_sword"
          ]
        },
        {
          "text": "把第三十六照实读，不借末席恭维地方前辈。",
          "tags": [
            "cid:lm_correct_label"
          ]
        },
        {
          "text": "把水给刚下场的两位，各问一次要不要帮忙。",
          "tags": [
            "cid:lm_offer_water"
          ]
        },
        {
          "text": "先接住弟子和剑鞘，错过后几剑也不挤回去。",
          "tags": [
            "cid:lm_help_sheath"
          ]
        },
        {
          "text": "问许重山，我借刀时那一刀也在先定终点么？",
          "tags": [
            "cid:lm_ask_first"
          ]
        },
        {
          "text": "从脚说起：想起自己出刀后两脚挤住，明早请许推一推。",
          "tags": [
            "cid:lm_night_foot"
          ]
        },
        {
          "text": "不讨一个今日必能进榜的改口，问余下还愿怎样练。",
          "tags": [
            "cid:lm_he_ask_remaining"
          ]
        },
        {
          "text": "请许再推一回，自己从刚才没接上的地方重做，耽误一些收拾行装的时辰。",
          "tags": [
            "cid:lm_repeat_with_push"
          ]
        },
        {
          "text": "还刀，办完门里的交代，再随石惊川走一段。",
          "tags": [
            "cid:lm_travel_choice"
          ]
        },
        {
          "text": "回门里照实讲撤酒缘故，不替罗老编一场没打过的胜。",
          "tags": [
            "cid:lm_keep_record"
          ]
        }
      ],
      "beats": [
        {
          "text": "你想借镇河门一把木刀，到秋会上换人试手。许重山没把刀递过来，先问你第七刀砍谁。",
          "tags": [
            "beat:lm_borrow_1",
            "scene:lm_hall",
            "cast:lm_xu",
            "speaker:narrator"
          ]
        },
        {
          "text": "第七刀……接在第六刀后面。",
          "tags": [
            "beat:lm_borrow_2",
            "scene:lm_hall",
            "cast:lm_xu",
            "speaker:you"
          ]
        },
        {
          "text": "许重山垂下木刀。这句话没有把宋老第七刀的问题抹掉，却让他重新听见一个原先没问过的后半句。",
          "tags": [
            "beat:lm_qinghe_third_5",
            "scene:lm_qingheyard",
            "cast:lm_qinghe,lm_xu",
            "speaker:narrator"
          ]
        },
        {
          "text": "你说第七刀砍什么，他现在也答不出。换一句。",
          "tags": [
            "beat:lm_route_first_day_3",
            "scene:lm_hall",
            "cast:lm_xu",
            "speaker:lm_xu",
            "mood:lm_xu=neutral"
          ]
        },
        {
          "text": "第一百一十九合，剑越过刀背半寸，停在肋下；许的刀几乎同时到石右肩。",
          "tags": [
            "beat:lm_xu_bout_2",
            "scene:lm_challenge",
            "cast:lm_xu,lm_shi",
            "speaker:narrator"
          ]
        },
        {
          "text": "一百一十九合照实记了，没拿旧伤垫一句。后来罗天庆记贺老的十九、三十二、四十一，也都这样一招一合记着。",
          "tags": [
            "beat:lm_sore_6",
            "scene:lm_hall",
            "cast:lm_xu,lm_luo",
            "speaker:narrator"
          ]
        },
        {
          "text": "你看见第一剑，没有看全后八剑。后来不能替自己说成九剑全懂。",
          "tags": [
            "beat:lm_wooden_10",
            "scene:lm_nine",
            "cast:lm_zhang_v2,lm_shi,lm_fan",
            "speaker:narrator"
          ]
        },
        {
          "text": "你也想说一句九剑如何，话到口边才想起，自己究竟亲眼看了几下。",
          "tags": [
            "beat:lm_night_outer_4",
            "scene:lm_nightouter",
            "cast:lm_xu,lm_shi",
            "speaker:narrator"
          ]
        },
        {
          "text": "白日他只接九剑，话里却没有把那个肯连问的人轻轻略过去。你将杯端近一点，问起自己。",
          "tags": [
            "beat:lm_night_private_3",
            "scene:lm_nightprivate",
            "cast:lm_zhang_v2",
            "speaker:narrator"
          ]
        }
      ],
      "ending": {
        "text": "后来回镇河门，你先把沿途答应的杂事办完，再问能不能借一把出门用的木刀。许让你取出借刀册，你在旧名字下写了新的归期。",
