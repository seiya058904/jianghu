{
  "method": "Read-only inkjs Story runtime, first option except listed CID overrides; not browser playthrough.",
  "results": [
    {
      "slug": "sea",
      "label": "dead-future",
      "choices": [
        {
          "text": "先踩实脚下，接住这一掌再转身。",
          "tags": [
            "cid:sr_wait_weight"
          ]
        },
        {
          "text": "问船人，过了眼前这班还能转到哪里。",
          "tags": [
            "cid:sr_ask_farther"
          ]
        },
        {
          "text": "去外港问转船，先跟船工把这一箱搬上去。",
          "tags": [
            "cid:sr_take_open_route"
          ]
        },
        {
          "text": "把缆交给阿汀，自己去拦推人的手。",
          "tags": [
            "cid:sr_trust_line"
          ]
        },
        {
          "text": "把岸上人让到缆外，自己接来拳，不借别人会跌水的地方逼胜。",
          "tags": [
            "cid:sr_give_step"
          ]
        },
        {
          "text": "留下来真学蓬莱的步与兵器，不只数祖师胜过几个。",
          "tags": [
            "cid:sr_ask_local_method"
          ]
        },
        {
          "text": "拾起剑，请他再试刚才卸腕的半掌。",
          "tags": [
            "cid:sr_ask_lost_grip"
          ]
        },
        {
          "text": "问怎样往更强处去，承认自己此刻仍最想打赢。",
          "tags": [
            "cid:sr_ask_route_to_strong"
          ]
        },
        {
          "text": "请阿汀帮找住处与大夫，先承认站不住，不在码头硬演强者。",
          "tags": [
            "cid:sr_accept_help"
          ]
        },
        {
          "text": "把阿罗真写在药包旁，再写下新名罗天海。",
          "tags": [
            "cid:sr_say_old_name"
          ]
        },
        {
          "text": "先认他一步能进到哪里，接住第一轮真招，再把自己的问递过去。",
          "tags": [
            "cid:sr_answer_with_distance"
          ]
        },
        {
          "text": "照对方指的地方继续找，不拿一场胜当所有中原武人的同一种答复。",
          "tags": [
            "cid:sr_go_find_more"
          ]
        },
        {
          "text": "把两次败里同一处没接住的变化再摆出来，不拿后来一平擦掉以前。",
          "tags": [
            "cid:sr_admit_repeat"
          ]
        },
        {
          "text": "照老人的住处上山，请问手，也请问自己的路。",
          "tags": [
            "cid:sr_seek_zhao_plain"
          ]
        },
        {
          "text": "实说因为他比自己强，愿意从这里学起。",
          "tags": [
            "cid:sr_zhao_stronger"
          ]
        },
        {
          "text": "下山后开个小馆，让普通学生把每天真能做的练习带回来，先听他们怎样用。",
          "tags": [
            "cid:sr_teach_daily"
          ]
        },
        {
          "text": "再出门问手前，把下一班怎样接清楚，留下自己会回来的日子。",
          "tags": [
            "cid:sr_leave_class_in_turn"
          ]
        },
        {
          "text": "不追着给招取名，先接眼前的人，把这一下真正走完。",
          "tags": [
            "cid:sr_follow_person"
          ]
        },
        {
          "text": "请两名学生各把自己能续的一步走出来，再谈新门要留下什么。",
          "tags": [
            "cid:sr_rule_try"
          ]
        },
        {
          "text": "有人要称第七大派时，先问自己不在以后谁还能继续教。",
          "tags": [
            "cid:sr_ask_next_teacher"
          ]
        },
        {
          "text": "晚年少接远行，把能教的日子留在院中，亲眼看别人怎样不再照你走。",
          "tags": [
            "cid:sr_late_teach"
          ]
        },
        {
          "text": "留旧友再坐一阵，明早的课照常，不把这一夜急着写成后世定论。",
          "tags": [
            "cid:sr_keep_old_visit"
          ]
        },
        {
          "text": "让他把来历与疑处一并留下，卷可以读，不能替祖师编一个已经证明的终局。",
          "tags": [
            "cid:sr_pages_as_question"
          ]
        }
      ],
      "beats": [
        {
          "text": "你先问了自己不在以后谁教。第三代宗主出返真那年，有人说这主意下得早；你只答，门是接出来的，不是称出来的。",
          "tags": [
            "beat:sr_seventh_4",
            "scene:sr_newhall",
            "cast:sr_carpenter,sr_seller",
            "speaker:narrator"
          ]
        }
      ],
      "ending": {
        "text": "你留下的院门没有把人关在你的那一步。后来有人问祖师最会什么，学生先走出自己的拳，再说：他肯看我们重来。",
        "tags": [
          "beat:sr_after_life_5",
          "scene:sr_afterhall",
          "cast:none",
          "speaker:narrator",
          "ending:sr_open_courtyard"
        ]
      },
      "totalBeats": 210
    },
    {
      "slug": "white-stone",
      "label": "denied-win",
      "choices": [
        {
          "text": "将每次接不上处另记，先告诉同来的人自己还不知道什么。",
          "tags": [
            "cid:ws_note_break"
          ]
        },
        {
          "text": "将缺处如实留给内议，不用自己的顺手写成祖传最后一步。",
          "tags": [
            "cid:ws_keep_gap"
          ]
        },
        {
          "text": "先为一脉找第二个能理解的人，向老人讲明并非叫人照抄全部秘谱。",
          "tags": [
            "cid:ws_find_second"
          ]
        },
        {
          "text": "把另一脉看懂了什么留在卷后，而不只记谁又学了一式。",
          "tags": [
            "cid:ws_record_reason"
          ]
        },
        {
          "text": "先问少林后山法晦能否见，得到不见外客的答复，就在山下住。",
          "tags": [
            "cid:ws_ask_old_name"
          ]
        },
        {
          "text": "将这一场停在双方都收手的地方，继续问别山上一代还剩谁。",
          "tags": [
            "cid:ws_keep_no_result"
          ]
        },
        {
          "text": "向他谢今日肯试，不用年轻二十年这个未知假设抹掉他现在的深处。",
          "tags": [
            "cid:ws_ask_today"
          ]
        },
        {
          "text": "有人问是否天下第一，只答天下太大，没有刚好全见过。",
          "tags": [
            "cid:ws_keep_unknown"
          ]
        },
        {
          "text": "请顾指出自己刚才先看哪块地，不替他报出你记得的那一块。",
          "tags": [
            "cid:ws_ask_own_stone"
          ]
        },
        {
          "text": "留下原先在哪些地方硬凑的记录，供后来者辨认，不把自己的删法又立成唯一练法。",
          "tags": [
            "cid:ws_keep_life_notes"
          ]
        },
        {
          "text": "在旧录后留下确定与未定的边界，不把祖师未归的年份当作已死之年。",
          "tags": [
            "cid:ws_keep_limits"
          ]
        },
        {
          "text": "旧谱第一退下后，先在自己总抢快的一处停，问不抢时这一剑还能如何接。",
          "tags": [
            "cid:ws_ask_slow_hand"
          ]
        },
        {
          "text": "携帖去山外，约好回来先讲一个看懂的变化与一个没问明白的问题。",
          "tags": [
            "cid:ws_go_observe"
          ]
        }
      ],
      "beats": [
        {
          "text": "今日是你高。",
          "tags": [
            "beat:ws_old_palm_4",
            "scene:ws_trial",
            "cast:ws_dongxuan",
            "speaker:ws_dongxuan",
            "mood:ws_dongxuan=neutral"
          ]
        },
        {
          "text": "山外后来传的是\"今日是你高\"，他自己从未这么认过。",
          "tags": [
            "beat:ws_old_palm_10",
            "scene:ws_trial",
            "cast:ws_dongxuan",
            "speaker:narrator"
          ]
        }
      ],
      "ending": {
        "text": "你出谷时有人问昆仑到底多少人。你答只知道今日亲见的这些，转而问他的来路。那人讲起山道新换的过法，你第一次没有先问那地方谁最强。",
        "tags": [
          "beat:ws_today_after_2",
          "scene:ws_snow",
          "cast:none",
          "speaker:narrator",
          "ending:ws_outside_after"
        ]
      },
      "totalBeats": 128
    },
    {
      "slug": "xuanmen",
      "label": "wrong-memory",
      "choices": [
        {
          "text": "先问老人是谁，承认昨日见过二十一剑，仍没看懂今日。",
          "tags": [
            "cid:xm_ask_his_name"
          ]
        },
        {
          "text": "在访客簿记俞断剑、自己十四招负，不拿老人无名替两场遮过去。",
          "tags": [
            "cid:xm_keep_result"
          ]
        },
        {
          "text": "先将诸院能通的侧路交给张无垢，和他逐处点明换班的人。",
          "tags": [
            "cid:xm_make_handover"
          ]
        },
        {
          "text": "请每处回一张接班条，让伤药与经阁都知道下一个人到了没有。",
          "tags": [
            "cid:xm_send_receipt"
          ]
        },
        {
          "text": "看师父怎样借湿地、石阶和石苍旧伤，记得这一战发生在什么地方。",
          "tags": [
            "cid:xm_watch_feet"
          ]
        },
        {
          "text": "去伤药处认回需要的人，把私事交给同伴，自己留下等最后一班。",
          "tags": [
            "cid:xm_help_medicine"
          ]
        },
        {
          "text": "先把七院藏谱副本互通，找别院的人来认自己抄不明白的字。",
          "tags": [
            "cid:xm_copy_methods"
          ]
        },
        {
          "text": "让他把没问明白的带回去，今日少练一遍，不替徒弟抢着答完。",
          "tags": [
            "cid:xm_let_him_ask"
          ]
        },
        {
          "text": "在自己的手录写下嫉妒，不将那一夜涂成从未有过的欢喜。",
          "tags": [
            "cid:xm_write_envy"
          ]
        },
        {
          "text": "九席有空时，先问还有哪件事没人接，再问候选人会不会做。",
          "tags": [
            "cid:xm_ask_successor"
          ]
        },
        {
          "text": "把旧录里各处如何接手留给后来人读，允许他们按今日重新分工。",
          "tags": [
            "cid:xm_leave_duties"
          ]
        }
      ],
      "beats": [
        {
          "text": "从泥地里来的。那日我只问了师父在汉水边怎么躺。",
          "tags": [
            "beat:xm_another_court_10",
            "scene:xm_court",
            "cast:xm_xuandu",
            "speaker:you"
          ]
        }
      ],
      "ending": {
        "text": "后来翻旧录的门人，将一页旧分工放在今日新图旁边。他没照旧路搬药，先去问新接班的人是否真到了；页上仍留着张无垢那个并非第九高手的名字。",
        "tags": [
          "beat:xm_last_day_6",
          "scene:xm_archive",
          "cast:none",
          "speaker:narrator",
          "ending:xm_handover_after"
        ]
      },
      "totalBeats": 105
